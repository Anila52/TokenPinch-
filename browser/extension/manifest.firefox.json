{
  "manifest_version": 3,
  "name": "TokenPinch",
  "version": "1.2.0",
  "description": "Compress the current chat draft locally before it is sent.",
  "browser_specific_settings": {
    "gecko": { "id": "tokenpinch@clausetenconsulting.com", "strict_min_version": "128.0" }
  },
  "permissions": ["nativeMessaging", "storage", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": { "scripts": ["background.js"] },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
      "js": ["policy.js", "adapters.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
